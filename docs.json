{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hybrid Greentech",
  "colors": {
    "primary": "#0F8189",
    "light": "#39A8B3",
    "dark": "#0B6E77"
  },
  "background": {
    "color": {
      "light": "#FAFAF7",
      "dark": "#0C1F25"
    }
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon-dark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "house",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "api-versioning"]
          },
          {
            "group": "Changelog",
            "pages": ["changelog"]
          }
        ]
      },
      {
        "tab": "Individual Sites",
        "icon": "plug-zap",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "delegated-operators/welcome",
              "delegated-operators/quickstart",
              "delegated-operators/operational-flow"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              {
                "group": "Delegated Operators",
                "asyncapi": {
                  "source": "/api-reference/asyncapi/delegated-operators.yaml",
                  "directory": "api-reference/delegated-operators"
                }
              }
            ]
          }
        ]
      },
      {
        "tab": "Distributed Energy Resources",
        "icon": "zap",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "distributed-resources/welcome",
              "distributed-resources/quickstart",
              "distributed-resources/migration"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              {
                "group": "Distributed Energy Resources (v2)",
                "asyncapi": {
                  "source": "/api-reference/asyncapi/distributed-resources.yaml",
                  "directory": "api-reference/distributed-resources"
                }
              }
            ]
          },
          {
            "group": "EV Chargers (v1, deprecated)",
            "expanded": false,
            "pages": [
              "ev-chargers/quickstart",
              {
                "group": "API Reference",
                "asyncapi": {
                  "source": "/api-reference/asyncapi/ev-chargers.yaml",
                  "directory": "api-reference/ev-chargers"
                }
              }
            ]
          },
          {
            "group": "Heat Pumps (v1, deprecated)",
            "expanded": false,
            "pages": [
              "heat-pumps/quickstart",
              {
                "group": "API Reference",
                "asyncapi": {
                  "source": "/api-reference/asyncapi/heat-pumps.yaml",
                  "directory": "api-reference/heat-pumps"
                }
              }
            ]
          }
        ]
      },
      {
        "tab": "OEM Integration",
        "icon": "factory",
        "groups": [
          {
            "group": "Get started",
            "pages": ["controller/overview", "controller/signal-list"]
          }
        ]
      },
      {
        "tab": "Data Standards",
        "icon": "gauge",
        "groups": [
          {
            "group": "Get started",
            "pages": ["data-standards/overview"]
          },
          {
            "group": "Requirements",
            "pages": [
              "data-standards/markets",
              "data-standards/metrics",
              "data-standards/compliance"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "braces",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview", "api-versioning"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/delegated-operators/data-standards",
      "destination": "/data-standards/overview"
    }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "fonts": {
    "family": "PP Neue Montreal",
    "weight": 400,
    "source": "/fonts/PPNeueMontreal-Regular.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
